<UserControl x:Class="DiscImageStudio.Views.DriveTimingCalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DiscImageStudio.Localization"
             xmlns:controls="clr-namespace:DiscImageStudio.Controls">
    <!-- One disc, one button: the page states the cost, shows the drive state, and keeps the
         measurement plan behind the advanced disclosure. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left" Margin="0,0,0,16">
            <TextBlock Text="{loc:Text Timing.NewDiscTitle}" FontSize="26" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2,0,10" />
            <TextBlock Text="{loc:Text Timing.OneClickIntro}" Style="{StaticResource BodyText}"
                       TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock Text="{loc:Text Timing.OneClickCost}" Style="{StaticResource CompactHint}"
                       TextWrapping="Wrap" Margin="0,0,0,18" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{loc:Text Timing.InsertDisc}" Style="{StaticResource BodyText}"
                               TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding TimingDriveState}" Style="{StaticResource CompactHint}" TextWrapping="Wrap" />
                </StackPanel>
                <!-- The primary style fixes the height; padding here only widens it, and the
                     label follows the button's own font size, so nothing gets clipped. -->
                <Button Grid.Column="1" Command="{Binding StartTimingCalibrationCommand}"
                        Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                        Padding="28,0" FontSize="15" FontWeight="SemiBold"
                        Content="{loc:Text Timing.OneClickStart}"
                        AutomationProperties.AutomationId="StartTimingCalibration" />
            </Grid>

            <TextBlock Text="{Binding TimingStatus}" Style="{StaticResource BodyText}"
                       TextWrapping="Wrap" Margin="0,12,0,0" />

            <Expander Header="{loc:Text Timing.Advanced}" IsExpanded="{Binding TimingAdvancedOpen}"
                      HorizontalAlignment="Stretch" Margin="0,16,0,0">
                <StackPanel MaxWidth="480" HorizontalAlignment="Left" Margin="8,2,0,0">
                    <TextBlock Text="{loc:Text Timing.AdvancedHint}" Style="{StaticResource CompactHint}"
                               TextWrapping="Wrap" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,2">
                        <TextBlock Text="{loc:Text Timing.LadderCount}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding TimingLadderLabel}" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="13" />
                    </Grid>
                    <Slider Style="{StaticResource ToneSlider}" Minimum="8" Maximum="96" SmallChange="1"
                            LargeChange="4" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding TimingLadderCount, Mode=TwoWay}" IsEnabled="{Binding CanEditTiming}"
                            AutomationProperties.Name="{loc:Text Timing.LadderCount}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,2">
                        <TextBlock Text="{loc:Text Timing.SamplesPerRung}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding TimingSamplesLabel}" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="13" />
                    </Grid>
                    <Slider Style="{StaticResource ToneSlider}" Minimum="8" Maximum="64" SmallChange="1"
                            LargeChange="4" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding TimingSamplesPerRung, Mode=TwoWay}" IsEnabled="{Binding CanEditTiming}"
                            AutomationProperties.Name="{loc:Text Timing.SamplesPerRung}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,2">
                        <TextBlock Text="{loc:Text Timing.StartPercent}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding TimingStartLabel}" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="13" />
                    </Grid>
                    <Slider Style="{StaticResource ToneSlider}" Minimum="1" Maximum="20" SmallChange="1"
                            LargeChange="2" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding TimingStartPercent, Mode=TwoWay}" IsEnabled="{Binding CanEditTiming}"
                            AutomationProperties.Name="{loc:Text Timing.StartPercent}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,2">
                        <TextBlock Text="{loc:Text Timing.EndPercent}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding TimingEndLabel}" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="13" />
                    </Grid>
                    <Slider Style="{StaticResource ToneSlider}" Minimum="60" Maximum="96" SmallChange="1"
                            LargeChange="4" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding TimingEndPercent, Mode=TwoWay}" IsEnabled="{Binding CanEditTiming}"
                            AutomationProperties.Name="{loc:Text Timing.EndPercent}" Margin="0,0,0,12" />

                    <controls:VisibilityGate IsOpen="{Binding IsDvdTiming}">
                        <CheckBox Content="{loc:Text Timing.CubicPitchLabel}" IsChecked="{Binding UseCubicPitch, Mode=TwoWay}"
                                  IsEnabled="{Binding CanUseCubicPitch}" Style="{StaticResource CompactCheckBox}"
                                  Margin="0,0,0,12" />
                    </controls:VisibilityGate>

                    <TextBlock Text="{loc:Text Timing.ReuseHint}" Style="{StaticResource CompactHint}"
                               TextWrapping="Wrap" Margin="0,0,0,8" />
                    <WrapPanel>
                        <Button Command="{Binding MeasureDriveTimingCommand}" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,8" Padding="14,8" AutomationProperties.AutomationId="MeasureDriveTiming">
                            <TextBlock Text="{loc:Text Timing.Measure}" TextWrapping="Wrap" />
                        </Button>
                        <Button Command="{Binding OpenTimingRecordCommand}" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,8">
                            <TextBlock Text="{loc:Text Timing.OpenRecord}" TextWrapping="Wrap" />
                        </Button>
                        <Button Command="{Binding RefreshTimingReadersCommand}" Style="{StaticResource CompactButton}"
                                Margin="0,0,10,8" VerticalAlignment="Center" Content="{loc:Text Timing.Refresh}" />
                        <Button Command="{Binding StreamBurnTimingImageCommand}" Style="{StaticResource CompactButton}"
                                Margin="0,0,10,8" VerticalAlignment="Center"
                                AutomationProperties.AutomationId="StreamBurnTimingImage">
                            <TextBlock Text="{loc:Text Timing.StreamBurn}" TextWrapping="Wrap" />
                        </Button>
                        <Button Command="{Binding GenerateTimingImageCommand}" Style="{StaticResource CompactButton}"
                                Margin="0,0,0,8" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Text Timing.CreateImage}" TextWrapping="Wrap" />
                        </Button>
                    </WrapPanel>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Text Xaml.DiscType}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding TimingMediaChoices}" SelectedItem="{Binding SelectedDiscType}"
                                      IsEnabled="{Binding CanEditTiming}" MinWidth="90"
                                      AutomationProperties.Name="{loc:Text Xaml.DiscType}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0" MinWidth="130">
                            <TextBlock Text="{loc:Text Timing.TotalSectors}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                            <TextBox Text="{Binding TimingTotalSectors, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditTiming}"
                                     AutomationProperties.Name="{loc:Text Timing.TotalSectors}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" MinWidth="90">
                            <TextBlock Text="{loc:Text Timing.ReadSpeed}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                            <TextBox Text="{Binding TimingReadSpeed, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditTiming}"
                                     AutomationProperties.Name="{loc:Text Timing.ReadSpeed}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{loc:Text Timing.CapacityHelp}" Style="{StaticResource CompactHint}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Expander>

            <controls:VisibilityGate IsOpen="{Binding HasTimingResult}">
                <Border Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" Padding="16" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Text Timing.ResultTitle}" Style="{StaticResource CardTitle}"
                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding TimingSummary}" Style="{StaticResource BodyText}"
                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding TimingResultHint}" Style="{StaticResource BodyText}"
                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding CubicPitchStatus}" Style="{StaticResource CompactHint}"
                                   TextWrapping="Wrap" Margin="0,0,0,12" />
                        <WrapPanel>
                            <Button Command="{Binding ApplyTimingResultCommand}" Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,12,8" Padding="14,8" AutomationProperties.AutomationId="ApplyDriveTiming">
                                <TextBlock Text="{loc:Text Timing.Apply}" TextWrapping="Wrap" />
                            </Button>
                            <Button Command="{Binding StartFineFromTimingCommand}" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,12,8" AutomationProperties.AutomationId="StartFineFromTiming">
                                <TextBlock Text="{loc:Text Timing.GoFine}" TextWrapping="Wrap" />
                            </Button>
                            <Button Command="{Binding SaveTimingRecordCommand}" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,0,8">
                                <TextBlock Text="{loc:Text Timing.SaveRecord}" TextWrapping="Wrap" />
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </controls:VisibilityGate>
        </StackPanel>
    </ScrollViewer>
</UserControl>
